graph TD
    %% Custom Styling
    classDef init fill:#2d3748,stroke:#4a5568,stroke-width:2px,color:#fff;
    classDef isr fill:#1a365d,stroke:#2b6cb0,stroke-width:2px,color:#fff;
    classDef task fill:#22543d,stroke:#38a169,stroke-width:2px,color:#fff;
    classDef main fill:#742a2a,stroke:#c53030,stroke-width:2px,color:#fff;

    Start([Nguồn/Reset]) --> Init[Khởi tạo Hệ thống<br/>- Setup UART 115200<br/>- Pin D6 Output<br/>- Timer1 CTC 1ms]:::init

    Init --> MainLoop{Vòng lặp chính<br/>Super-Loop}:::main

    %% ISR Path
    subgraph ISR_Block [NGẮT CỨNG - Timer1 COMPA ISR]
        T1Tick[Timer1 Ngắt mỗi 1ms] --> DecCounter[Giảm các bộ đếm Task]
        DecCounter --> CheckExpire{Bộ đếm = 0?}
        CheckExpire -- Yes --> SetFlag[Bật Flag Task tương ứng<br/>& Nạp lại Counter]
    end

    %% Task Execution Paths
    MainLoop -- flag_task1 == true --> T1[Task 1: Đọc ADC A0<br/>Chu kỳ 10ms]:::task
    T1 --> ResetF1[Gán flag_task1 = false] --> MainLoop

    MainLoop -- flag_task2 == true --> T2[Task 2: Xuất PWM D6<br/>Chu kỳ 20ms]:::task
    T2 --> ResetF2[Gán flag_task2 = false] --> MainLoop

    MainLoop -- flag_task3 == true --> T3[Task 3: Đọc Sensor A1<br/>Chu kỳ 100ms]:::task
    T3 --> ResetF3[Gán flag_task3 = false] --> MainLoop

    MainLoop -- flag_task4 == true --> T4[Task 4: Gửi UART<br/>Chu kỳ 1000ms]:::task
    T4 --> ResetF4[Gán flag_task4 = false] --> MainLoop
